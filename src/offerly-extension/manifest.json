{
  "manifest_version": 3,
  "name": "Offerly",
  "version": "1.0.3",
  "description": "Fill basic information, attach your resume, and draft tailored application answers.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "sidePanel"
  ],
  "icons": {
  "16": "offerly.png",
  "32": "offerly.png",
  "48": "offerly.png",
  "128": "offerly.png"
},
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "questionDrafts.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
  "default_title": "Open Offerly Side Panel",
  "default_icon": {
    "16": "offerly.png",
    "32": "offerly.png"
  }
}
}