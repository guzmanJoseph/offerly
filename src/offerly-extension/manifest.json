
{
  "manifest_version": 3,
  "name": "Offerly",
  "version": "1.0.0",
  "description": "Save and autofill job applications with Offerly.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Offerly Side Panel"
  }
}
